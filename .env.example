# TravelerLoot Environment Variables
# Copy this file to .env.local and fill in your values

# Infura Project ID (required for WalletConnect)
NEXT_PUBLIC_INFURA_ID=your_infura_project_id_here

# Contract Address (auto-generated by deploy script)
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Deployment Configuration
MNEMONIC=your_mnemonic_seed_here
PROVIDER_URL=https://mainnet.infura.io/v3/your_infura_project_id_here
